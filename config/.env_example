# ========================
# SFTP CONFIGURATION
# ========================
SFTP_HOST=Your_SFTP_HOST_HERE
SFTP_PORT=Your_SFTP_PORT_HERE
SFTP_USER="Your_SFTP_USER_HERE"
SFTP_PASSWORD="Your_SFTP_PASSWORD_HERE"
# CV bank root — must match the sftp_cv_theque volume mount path in docker-compose.yml
# (Action 230). Paramiko also uses this for staging uploads; offer_only matching reads
# CV JSONs directly from this mounted path instead of copying into intermediary_structured.
SFTP_ROOT_PATH="/Your_SFTP_ROOT_PATH_HERE"

# SFTP connection tuning (defaults mirror config/config_yaml.yaml sftp: section)
SFTP_CONNECT_TIMEOUT_SECONDS=10
SFTP_OPERATION_TIMEOUT_SECONDS=30
SFTP_MAX_RETRY_ATTEMPTS=4
SFTP_RETRY_BACKOFF_SECONDS=1.0

# ========================
# SFTP STAGING WATCHER
# ========================
WATCHER_STAGING_PATH=YOUR_SFTP_STAGING_PATH_HERE
WATCHER_POLL_INTERVAL_SECONDS=30
WATCHER_MAX_WORKERS=4

# ========================
# LLM (OpenRouter)
# ========================
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY_HERE

# ========================
# GOOGLE DRIVE CV IMPORT
# ========================
# Preferred: an OAuth desktop/web client plus a refresh token minted for the
# read-only scope https://www.googleapis.com/auth/drive.readonly. The API
# exchanges the refresh token for short-lived access tokens itself and caches
# them in memory, so Shared Drive inventory/import runs no longer stop when a
# hand-pasted token expires. Leave empty here and inject the real values via
# the deployment environment; never commit them.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=

# Legacy fallbacks, read only when the three variables above are all empty:
# a hand-pasted OAuth access token for private files, or an API key for
# public/shared-by-link files.
GOOGLE_DRIVE_ACCESS_TOKEN=
GOOGLE_DRIVE_API_KEY=

# ========================
# API RATE LIMITING & CORS
# ========================
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000
RATE_LIMIT_PER_DAY=10000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ========================
# DATABASE CONFIGURATION
# ========================
SECRET_KEY=YOUR_SECRET_KEY_HERE
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD_HERE@localhost:5432/YOUR_DATABASE_NAME_HERE

# ========================
# DATA ROOT (Action 227/228)
# ========================
# Single root for ALL pipeline storage (offers, sessions, archives, api_jobs).
# Leave unset for local dev (falls back to <project>/data). In production point
# it at the SFTP "Data" share. Layout: DATA_ROOT/current, /archive, /api_jobs.
DATA_ROOT=/sftp/cv_tech/files/Data

# Action 228: the SFTP "Data" share is exposed to the api/watcher containers via a
# named Docker volume using the vieux/sshfs plugin (defined in docker-compose.yml).
# This works natively with Docker Desktop on Windows. Install once:
#   docker plugin install vieux/sshfs
# The volume authenticates with SFTP_PASSWORD (set in the SFTP CONFIGURATION block
# above) and connects to sshcmd "cv_tech_sftp@<SFTP_HOST>:/sftp/cv_tech/files/Data".
# No host-side sshfs mount or SFTP_DATA_MOUNT variable is required.

# NOTE: SFTP_ROOT_PATH (CV bank) and WATCHER_STAGING_PATH (staging) above are
# *remote* SFTP paths accessed over paramiko and are unrelated to DATA_ROOT.
# They remain /sftp/cv_tech/files/CV_Theque and /sftp/cv_tech/files/staging.
