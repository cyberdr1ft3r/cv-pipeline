# Copy to deploy/.env.prod, keep permissions restrictive, and replace every placeholder.
CV_PIPELINE_VERSION=2026.09.16-1

POSTGRES_DB=cv_pipeline
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-long-random-value
API_DB_USER=api_user
API_DB_PASSWORD=replace-with-a-url-safe-random-value
N8N_DB_PASSWORD=replace-with-a-long-random-value

SECRET_KEY=replace-with-at-least-32-random-characters
COOKIE_SECURE=true
CORS_ORIGINS=https://cv.example.com

# Keep loopback when a host TLS reverse proxy terminates HTTPS.
HTTP_BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080

RATE_LIMIT_PER_MINUTE=300

# Google Drive CV import. Prefer the OAuth refresh-token credential below: the API
# refreshes access tokens itself, so Shared Drive imports survive token expiry.
# Mint the refresh token for the read-only scope
# https://www.googleapis.com/auth/drive.readonly.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
# Legacy fallbacks, used only when the three variables above are empty.
GOOGLE_DRIVE_ACCESS_TOKEN=
GOOGLE_DRIVE_API_KEY=
OPENROUTER_API_KEY=replace-with-openrouter-api-key

# Watcher settings. The watcher is part of the standard production stack.
WATCHER_POLL_INTERVAL_SECONDS=30
WATCHER_MAX_WORKERS=4
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=replace-with-a-long-random-value
PGADMIN_PORT=5051
