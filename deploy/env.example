# Copy to project root as `.env` before `docker compose -f docker-compose.hub.yml up -d`
# Also copy `config/.env_example` to `config/.env` and fill secrets there.

# â”€â”€ Docker Hub images â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
DOCKERHUB_USER=thicham25
IMAGE_TAG=latest

# â”€â”€ Ports (host) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
API_PORT=8000
FRONTEND_PORT=3001
POSTGRES_PORT=5432

# â”€â”€ Database â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
POSTGRES_DB=cv_pipeline
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_strong_postgres_password
API_DB_USER=api_user
API_DB_PASSWORD=replace-with-a-url-safe-random-value
N8N_DB_PASSWORD=replace-with-a-long-random-value

# â”€â”€ API security (required â€” min 32 characters) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
SECRET_KEY=change_me_to_a_random_string_at_least_32_chars

# â”€â”€ CORS (comma-separated; include your frontend origin) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Local:  http://localhost:3001
# VPS:    https://app.yourdomain.com
CORS_ORIGINS=http://localhost:3001

# â”€â”€ Frontend API URL (only used when rebuilding the frontend image) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Pre-built Hub images default to /api/v1 (fine for local).
# On VPS with a public API hostname, rebuild frontend â€” see DEPLOYMENT.md.
NEXT_PUBLIC_API_URL=/api/v1

# â”€â”€ Local data root (docker-compose.hub.yml without SFTP overlay) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
CV_STORAGE_ROOT=/sftp/cv_tech/files
CV_LIBRARY_ROOT=/sftp/cv_tech/files/CV_Theque
DATA_ROOT=/sftp/cv_tech/files/Data

# Google Drive CV import (server-side staging import)
# Preferred: a Google service-account key with Viewer access to the Shared Drive.
# Container path of the mounted service-account key. Leave empty to keep the
# legacy token behaviour; set it to enable service-account authentication.
GOOGLE_DRIVE_SERVICE_ACCOUNT_FILE=
# Host path of the key file, used only as the compose bind source. Keep the
# key outside this repository and readable by the container user.
GOOGLE_DRIVE_SERVICE_ACCOUNT_HOST_FILE=
# Optional: scope folder listings to one Shared Drive (corpora=drive&driveId=).
GOOGLE_DRIVE_SHARED_DRIVE_ID=
# Legacy fallbacks, read only when GOOGLE_DRIVE_SERVICE_ACCOUNT_FILE is empty.
GOOGLE_DRIVE_ACCESS_TOKEN=
GOOGLE_DRIVE_API_KEY=

# â”€â”€ Infrastructure SFTP overlay only (not read by the application) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
SFTP_PASSWORD=your_sftp_password
SFTP_PORT=22
SFTP_SSHCMD=cv_tech_sftp@82.25.119.163:/sftp/cv_tech/files/Data
SFTP_CV_THEQUE_SSHCMD=cv_tech_sftp@82.25.119.163:/sftp/cv_tech/files/CV_Theque

# â”€â”€ Staging watcher (optional â€” enable with --profile watcher) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
WATCHER_STAGING_PATH=/sftp/cv_tech/files/staging
WATCHER_POLL_INTERVAL_SECONDS=30
WATCHER_MAX_WORKERS=4

# â”€â”€ pgAdmin (optional â€” enable with --profile tools) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
PGADMIN_EMAIL=admin@admin.com
PGADMIN_PASSWORD=admin



